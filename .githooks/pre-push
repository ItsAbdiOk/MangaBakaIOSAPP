#!/bin/sh
# Runs before every push. The point: broken code never leaves this machine, so
# nothing broken can reach TestFlight.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass once:  git push --no-verify   (use sparingly, it defeats the purpose)
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# One scratch root instead of four scattered /tmp paths, and it is cleaned up.
# An unsigned .xcarchive is a few hundred MB and four of these were being left
# behind across install-device.sh, this hook and AccessibilityAuditTests.
MB_TMP="${TMPDIR:-/tmp}/mangabaka-prepush"
mkdir -p "$MB_TMP"

RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m'); OFF=$(printf '\033[0m')
fail() { printf "%spre-push: %s%s\n" "$RED" "$1" "$OFF" >&2; exit 1; }
ok()   { printf "%s  ok%s  %s\n" "$GREEN" "$OFF" "$1"; }

echo "pre-push checks..."

# 1. A real token must never be committed or pushed. One script, shared with
#    ci_scripts/ci_pre_xcodebuild.sh — the two copies had different scopes and
#    CI had the weaker one.
Scripts/check-credentials.sh || fail "credential check failed (see above)"
ok "no credentials staged"

# 2. Lint. Error-severity rules cover force unwraps, print(), catch-alls.
if ! command -v swiftlint >/dev/null 2>&1; then
    fail "swiftlint is not installed. Run: brew install swiftlint"
fi
swiftlint lint --strict --quiet || fail "lint failed"
ok "lint clean"

# 3. project.yml is the source of truth; the committed .xcodeproj must match.
if ! command -v xcodegen >/dev/null 2>&1; then
    fail "xcodegen is not installed. Run: brew install xcodegen"
fi
xcodegen generate --quiet 2>/dev/null || xcodegen generate >/dev/null 2>&1
if ! git diff --quiet -- MangaBaka.xcodeproj; then
    fail "MangaBaka.xcodeproj is out of sync with project.yml. Commit the regenerated project.
  Note: the line above just ran 'xcodegen generate', which REWRITES the working
  tree. So this also fires when MangaBaka.xcodeproj was already dirty for an
  unrelated reason — check 'git diff --stat -- MangaBaka.xcodeproj' before
  assuming project.yml is the thing that changed."
fi
ok "project in sync"

# 4. Tests. The slow step, and the one that matters most.
#
#    By UDID, not by name. On 2026-09-14 this Mac had two devices called
#    "iPhone 17 Pro" (iOS 26.5 and 26.3), which makes 'name=' ambiguous:
#    xcodebuild picks one silently and, when the other is mid-shutdown, the
#    test host is killed. That is the SIGTERM flake.
SIM_UDID=$(Scripts/pick-simulator.sh) || fail "no iPhone simulator available to test against"

echo "  running tests on $SIM_UDID (this is the slow bit)..."
# Warnings are build errors now, so a warning fails here rather than scrolling
# past unnoticed the way an infinite-recursion warning once did.
# Not --quiet: quiet mode suppresses the per-test results, which are the whole
# reason to read this log when something fails.
# The timeout is new: neither xcodebuild step had one, so a hung poll or a
# stalled simulator boot hung the push with no upper bound. 120 s per test is
# far above anything here (the whole suite is ~70 s) — it is a deadlock guard,
# not a performance budget. A guess, chosen as "obviously too generous".
if ! xcodebuild test \
        -project MangaBaka.xcodeproj -scheme MangaBaka \
        -destination "platform=iOS Simulator,id=$SIM_UDID" \
        -test-timeouts-enabled YES \
        -default-test-execution-time-allowance 120 \
        >"$MB_TMP/tests.log" 2>&1; then
    printf "%spre-push: tests failed%s\n" "$RED" "$OFF" >&2
    grep -E "✘|error:|Expectation failed|Test run with" "$MB_TMP/tests.log" \
        | sed 's/^/  /' | head -25 >&2
    echo "  full log: $MB_TMP/tests.log" >&2
    exit 1
fi
ok "tests passed"

# 5. The Release archive, the way Xcode Cloud builds it. Builds 69 and 71
# (2026-09-13) died in the Swift 6.3.3 SIL verifier under whole-module
# optimisation on code that compiled fine in Debug and even in a plain
# Release *build* — only `xcodebuild archive` reproduced it. Unsigned:
# signing is Xcode Cloud's job; the compiler is what this checks.
#
# Skipped when nothing the compiler sees has changed since the last archive
# that passed. The archive is the only real lever on a ~10 minute hook, and a
# docs-only push was paying it in full. The memo lives in .git/, so it is
# per-clone and never committed; delete it to force a full archive.
ARCHIVE_MEMO="$(git rev-parse --git-dir)/mb-prepush-archive-ok"
# Every input to the compile: both source trees, the project description, the
# build settings, the resolved package versions, and the compiler itself.
#
# Trees from HEAD, not the working directory, because HEAD is what is being
# pushed — and because step 3 above just rewrote the tree. That is also why the
# memo is refused on a dirty tree below: `xcodebuild archive` compiles the
# *working* tree, so on a dirty tree the memo would record HEAD's hashes for an
# archive of something else, and the next clean push would skip the archive it
# never actually ran (review item 61, 2026-09-14).
#
# `xcodebuild -version` is in the stamp because the failure this step exists to
# catch — builds 69 and 71 dying in the Swift 6.3.3 SIL verifier — is a property
# of the compiler, not of the code. Without it, bumping Xcode on an unchanged
# tree skips the one check that would have found the next one of those.
#
# Package.resolved because it pins the dependency versions the archive compiles
# against and lives inside the excluded .xcodeproj, so a dependency bump on its
# own looked like "no change".
#
# The `tr` is deliberately *not* in the same pipeline as `git rev-parse`. It was,
# and a pipeline's exit status is its last command's, so a renamed stamped path
# was invisible twice over: the failure was swallowed, and `git rev-parse` echoes
# the argument it could not resolve to stdout, so the stamp became a constant
# string containing that literal path. Constant means it matches the memo on
# every subsequent push — the archive would have been skipped forever, silently.
# (Measured 2026-09-14: `git rev-parse HEAD:MangaBaka HEAD:NoSuchDir` exits 128
# and prints `HEAD:NoSuchDir`; piped to `tr`, the `if` saw 0.)
#
# Empty means "archive unconditionally and write no memo", which is the safe
# direction, and both guards below already read it that way.
if SOURCE_STAMP=$(
    git rev-parse HEAD:MangaBaka HEAD:MangaBakaWidgets HEAD:project.yml HEAD:Configs \
        HEAD:MangaBaka.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved \
        2>/dev/null
) && TOOLCHAIN_STAMP=$(xcodebuild -version 2>/dev/null); then
    SOURCE_STAMP=$(printf '%s\n%s' "$SOURCE_STAMP" "$TOOLCHAIN_STAMP" | tr '\n' ' ')
else
    SOURCE_STAMP=""
fi

# Dirty in anything the compiler sees. Scoped to those paths so an edited README
# does not cost a ten-minute archive.
COMPILE_INPUTS_DIRTY=$(
    git status --porcelain -- MangaBaka MangaBakaWidgets project.yml Configs 2>/dev/null
) || COMPILE_INPUTS_DIRTY="dirty"

if [ -n "$SOURCE_STAMP" ] && [ -z "$COMPILE_INPUTS_DIRTY" ] && [ -f "$ARCHIVE_MEMO" ] \
   && [ "$(cat "$ARCHIVE_MEMO")" = "$SOURCE_STAMP" ]; then
    ok "Release archive skipped (no Swift, project or config change since the last one)"
else
    echo "  archiving unsigned Release (the other slow bit)..."
    if ! xcodebuild archive \
            -project MangaBaka.xcodeproj -scheme MangaBaka \
            -destination "generic/platform=iOS" \
            -archivePath "$MB_TMP/MangaBaka.xcarchive" \
            CODE_SIGNING_ALLOWED=NO \
            >"$MB_TMP/archive.log" 2>&1; then
        printf "%spre-push: Release archive failed%s\n" "$RED" "$OFF" >&2
        grep -E "error:|While running pass|for expression at" "$MB_TMP/archive.log" \
            | cut -c1-200 | sed 's/^/  /' | head -12 >&2
        echo "  full log: $MB_TMP/archive.log" >&2
        exit 1
    fi
    # Not `[ ... ] && printf`: under `set -e` an empty stamp would make that
    # line the script's last exit status and abort a push that just passed.
    #
    # Nothing is memoised off a dirty tree: see the stamp's comment above.
    # Removing any stale memo as well, so a later clean push cannot match one
    # written before this archive.
    if [ -n "$SOURCE_STAMP" ] && [ -z "$COMPILE_INPUTS_DIRTY" ]; then
        printf '%s' "$SOURCE_STAMP" >"$ARCHIVE_MEMO"
    else
        rm -f "$ARCHIVE_MEMO"
    fi
    # A few hundred MB, and nothing reads it after this point.
    rm -rf "$MB_TMP/MangaBaka.xcarchive"
    ok "Release archive compiles"
fi

echo "pre-push checks passed."
