# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
# Package.resolved is deliberately NOT ignored. Ignoring it is the convention
# for libraries, where the consumer picks versions. This is an app: the file
# pins the exact dependency versions, CI requires it (Xcode Cloud disables
# automatic resolution and fails without it), and without it a cloud build
# could silently resolve a different version than a local one.

# CocoaPods / Carthage
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets
*.xcconfig.local
.env
.env.*

# Local agent instructions
CLAUDE.md
.claude/

# Local secrets — never commit. A build containing a PAT grants account access
# to anyone holding the binary.
Configs/Secrets.xcconfig

# App Store Connect API identifiers — local only
Configs/asc.env
.gstack/

# Python — Scripts/*.py are run directly by developers and CI, and each run
# recreates this. Tracked once as Scripts/__pycache__/asc.cpython-314.pyc
# (docs/reviews/full/SUMMARY.md item 135); removed with `git rm --cached`.
__pycache__/
*.pyc

# Generated by MangaBakaTests/APIShapeModelledFieldsTests.swift for
# Scripts/api-shape-sweep.py to read — a build artifact of running the tests,
# not source. The script falls back to a hand-typed list with a warning when
# this is absent (docs/reviews/full/SUMMARY.md item 135).
Scripts/generated/

# Dated wire-shape reports from Scripts/api-contract-report.sh. Generated
# weekly; keeping them out of git stops a scheduled job dirtying the tree and
# tripping the pre-push project-sync check for an unrelated reason.
docs/api-contract-*.txt
TestFlight/
